# 1. Базовый образ: официальный Python 2.7 в варианте slim
#    (урезанный Debian без компиляторов и лишних пакетов -> маленький размер).
#    Проект написан на Python 2 (print e, flask.ext, неявные импорты), поэтому 2.7.
FROM python:2.7-slim

# 2. Переменные окружения:
#    PYTHONDONTWRITEBYTECODE=1 - не создавать .pyc файлы внутри контейнера
#    PYTHONUNBUFFERED=1        - логи сразу выводятся в `docker logs`, без буферизации
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 3. Рабочая директория внутри контейнера: все следующие команды выполняются здесь
WORKDIR /app

# 4. Сначала копируем ТОЛЬКО список зависимостей и ставим их.
#    Docker кэширует каждый слой: пока requirements.txt не меняется,
#    слой с pip install берётся из кэша и пересборка после правки кода идёт за секунды.
#    --no-cache-dir - не сохранять кэш pip в образе (меньше размер).
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 5. Теперь копируем остальной код проекта (с учётом .dockerignore),
#    включая базу данных todo.sqlite
COPY . .

# 6. Документируем, что приложение слушает порт 7345
#    (сам порт наружу открывает флаг -p при docker run)
EXPOSE 7345

# 7. Команда запуска. В manage.py сервер привязан к 127.0.0.1 - внутри контейнера
#    это означает "доступен только изнутри контейнера". Поэтому переопределяем хост
#    на 0.0.0.0 (все интерфейсы), чтобы проброс порта -p работал.
CMD ["python", "manage.py", "runserver", "--host", "0.0.0.0", "--port", "7345"]
