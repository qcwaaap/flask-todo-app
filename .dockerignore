# Кэш и скомпилированные файлы Python — в образе они не нужны, Python создаст их сам
__pycache__/
*.pyc
*.pyo
*.pyd

# Служебные файлы git — история репозитория в контейнере не нужна
.git
.gitignore

# Виртуальные окружения — зависимости ставятся внутри образа через pip
venv/
.venv/

# Секреты и переменные окружения — не должны попадать в образ
.env

# Файлы, которые не нужны для работы приложения
Dockerfile
.dockerignore
README*.md
